#!/bin/sh
# Never git add/commit/push/stash/checkout; a hook writes working-tree bytes at most.
set -u
[ "$3" = "0" ] && exit 0
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$root" || exit 0
if [ ! -f trinity/tools/pipeline.py ]; then
  echo "trinity gate: trinity/tools/pipeline.py is absent; is the submodule checked out?" >&2
  exit 0
fi
mkdir -p .sentinel || exit 0
python3 trinity/tools/pipeline.py render-reports ./ --check > .sentinel/post-checkout-reports.txt 2>&1 || echo "trinity gate: TRACKING.md is stale for this checkout; run python3 trinity/tools/pipeline.py render-reports ./" >&2
exit 0
