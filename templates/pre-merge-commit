#!/bin/sh
# Never git add/commit/push/stash/checkout; a hook writes working-tree bytes at most.
set -u
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 1
cd "$root" || exit 1
if [ ! -f trinity/tools/pipeline.py ]; then
  echo "trinity gate: trinity/tools/pipeline.py is absent; is the submodule checked out?" >&2
  exit 1
fi
mkdir -p .sentinel || exit 1
python3 trinity/tools/pipeline.py render-reports ./ --check --staged > .sentinel/pre-merge-reports.txt 2>&1
if [ $? -ne 0 ]; then
  grep '^wrote ' .sentinel/pre-merge-reports.txt >&2 || true
  printf '%s %s\n' 'review the rendered bytes and git' 'add them' >&2
  exit 1
fi
exit 0
